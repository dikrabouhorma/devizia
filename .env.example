# Copie ce fichier en .env.local et remplis les valeurs.
# Sans les variables Supabase, l'appli tourne en mode démo (parcours cliente sur /atelier-soie, rien n'est enregistré).

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète, uniquement côté serveur : ne jamais la préfixer par NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (console.anthropic.com). Sans clé, l'analyse des photos est simulée.
ANTHROPIC_API_KEY=
# Modèle utilisé pour l'analyse des photos (facultatif)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Mettre à true pour forcer l'analyse simulée, même avec une clé
AI_MOCK=false
